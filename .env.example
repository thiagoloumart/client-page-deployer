# Login (the first admin is created from these on first start)
ADMIN_USER=admin
ADMIN_PASS=change-me
SESSION_SECRET=long-random-string

# Server that will host the pages (reached over SSH)
VPS_HOST=127.0.0.1
VPS_PORT=22
VPS_USER=root
VPS_KEY_PATH=/root/.ssh/id_ed25519
VPS_IP=203.0.113.10

# Cloudflare zone of your domain
CF_API_TOKEN=your-cloudflare-token
CF_ZONE_ID=your-zone-id

# Domains
DEFAULT_DOMAIN=example.com
# Optional: other domains users may publish to (comma-separated)
ALLOWED_DOMAINS=example.com

# SSL
CERTBOT_EMAIL=you@example.com

PORT=3000
